{
  "pythonVersion": "3.13",
  "typeCheckingMode": "recommended",
  "venvPath": ".",
  "venv": ".venv",
  "stubPath": "typings",
  "allowedUntypedLibraries": [],
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "**/__pycache__",
    ",venv",
    "src/rpg_player/narration_screen.py",
    "src/rpg_player/config.py",
    "src/rpg_player/audio_transcriber.py",
    "src/rpg_player/audio_player.py",
    "src/rpg_player/app.py",
    "scripts/actor_tester.py",
    "tests/test_config.py",
    "tests/test_audio_transcriber.py",
    "tests/test_audio_player.py",
    "tests/conftest.py"
  ],
  "strict": [
    "src/rpg_player/domain",
    "src/rpg_player/agents",
    "src/rpg_player/voice"
  ],
  "executionEnvironments": []
}
